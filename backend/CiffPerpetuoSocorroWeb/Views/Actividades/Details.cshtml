@model CiffPerpetuoSocorroWeb.Models.Actividad

@{
    ViewData["Title"] = "Detalle de Actividad";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="m-0">Ficha Técnica: @Model.NombreActividad</h2>
        </div>
        <div class="card-body fs-5">
            <p><strong>Descripción:</strong> @Model.Descripcion</p>
            <p><strong>Fecha y Hora:</strong> @Model.FechaHora.ToString("dd/MM/yyyy HH:mm") hs</p>
            <p><strong>Educador a cargo:</strong> @(Model.Educador != null ? $"{Model.Educador.Nombre} {Model.Educador.Apellido} ({Model.Educador.Especialidad})" : "Sin educador asignado")</p>
        </div>
    </div>

    <h3 class="text-secondary mb-3">Beneficiarios Inscritos en este Taller</h3>

    <div class="row">
        @if (!Model.Beneficiarios.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning">No hay beneficiarios registrados en esta actividad todavía.</div>
            </div>
        }
        else
        {
            @foreach (var nene in Model.Beneficiarios)
            {
                <div class="col-md-4 mb-3">
                    <div class="card border-start border-info border-4 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-info fw-bold">@nene.Nombre @nene.Apellido</h5>
                            <p class="card-text mb-1"><strong>Edad:</strong> @nene.Edad años</p>
                            <p class="card-text text-muted small">Legajo: #@nene.Legajo</p>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="mt-3">
        <a href="/Actividades" class="btn btn-secondary px-4">Volver al Cronograma</a>
    </div>
</div>