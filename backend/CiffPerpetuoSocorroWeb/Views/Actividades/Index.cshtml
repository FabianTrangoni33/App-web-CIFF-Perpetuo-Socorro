@model IEnumerable<CiffPerpetuoSocorroWeb.Models.Actividad>

@{
    ViewData["Title"] = "Inicio - CIFF Perpetuo Socorro";
}

<div class="container mt-4">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
        <h1 class="display-5 fw-bold text-primary">C.I.F.F. Perpetuo Socorro</h1>
        <p class="col-md-8 fs-4 text-muted">Gestión interna de talleres, educadores y beneficiarios asistentes.</p>
    </div>

    <h2 class="mb-3 text-secondary">Cronograma de Actividades</h2>
    
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white m-0">
            <thead class="table-dark">
                <tr>
                    <th>Nombre del Taller</th>
                    <th>Descripción</th>
                    <th>Educador Responsable</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="fw-bold text-dark">@item.NombreActividad</span></td>
                        <td>@item.Descripcion</td>
                        <td>
                            @(item.Educador != null ? $"{item.Educador.Nombre} {item.Educador.Apellido}" : "Sin asignar")
                        </td>
                        <td class="text-center">
                            <a href="/Actividades/Details/@item.Id" class="btn btn-sm btn-outline-primary px-3">
                                Ver Inscriptos
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>